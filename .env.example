NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://root:root@localhost:3306/ecommerce_tinpavi
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Email (configure com seu servidor SMTP)
# Email (SMTP Hostinger)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_SECURE=false
# A02: Em dev pode ser false para SMTP local sem cert válido;
# Em produção, remova esta linha (padrão é true)
EMAIL_TLS_REJECT_UNAUTHORIZED=false
EMAIL_USER=seu-email@seudominio.com
EMAIL_PASS=change-me

# SEO
APP_BASE_URL=http://localhost:3000
ROBOTS_TXT_RULES=

# Shipping
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
SHIP_ORIGIN_ZIP_CODE=01001000
SHIP_ORIGIN_CITY=Sao Paulo
SHIP_ORIGIN_STATE=SP
SHIP_DEFAULT_WEIGHT_KG=0.3
SHIP_DEFAULT_LENGTH_CM=16
SHIP_DEFAULT_HEIGHT_CM=4
SHIP_DEFAULT_WIDTH_CM=11

# Security & Performance
CORS_ORIGIN=http://localhost:5173,http://192.168.100.39:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_GENERAL_MAX=300
# Set to true when running behind reverse proxy (nginx/load balancer)
TRUST_PROXY=true
JSON_BODY_LIMIT=256kb
FORM_BODY_LIMIT=256kb

# Payments
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
READINESS_TIMEOUT_MS=1500

# Payments / Webhook
PAYMENT_WEBHOOK_SECRET=change-me

# Database Connection Pool
# DB_POOL_MAX: maximum simultaneous database connections (dev: 5, prod: 20)
DB_POOL_MAX=5
# DB_POOL_IDLE_TIMEOUT_MS: how long an idle connection is kept before being released (ms)
DB_POOL_IDLE_TIMEOUT_MS=10000
# DB_POOL_ACQUIRE_TIMEOUT_MS: max wait time to acquire a connection from the pool before error (ms)
DB_POOL_ACQUIRE_TIMEOUT_MS=5000

# Database Profiling (set to 'true' to enable query logging)
DB_PROFILE=false
# Threshold in ms above which queries are emitted as db_slow_query events
DB_SLOW_QUERY_MS=100

# Docker / Compose Runtime
MYSQL_DATABASE=ecommerce_tinpavi
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=tinpavi
MYSQL_PASSWORD=tinpavi
MYSQL_PORT=3306
MYSQL_MEMORY_LIMIT=512m
MYSQL_CPU_LIMIT=1.0
MYSQL_HEALTHCHECK_INTERVAL=10s
MYSQL_HEALTHCHECK_TIMEOUT=5s
MYSQL_HEALTHCHECK_RETRIES=10
MYSQL_HEALTHCHECK_START_PERIOD=20s

BACKEND_MEMORY_LIMIT=512m
BACKEND_CPU_LIMIT=1.0
BACKEND_HEALTHCHECK_INTERVAL=10s
BACKEND_HEALTHCHECK_TIMEOUT=5s
BACKEND_HEALTHCHECK_RETRIES=10
BACKEND_HEALTHCHECK_START_PERIOD=20s
BACKEND_STOP_GRACE_PERIOD=30s

FRONTEND_MEMORY_LIMIT=256m
FRONTEND_CPU_LIMIT=0.5

NGINX_PORT=8080
NGINX_MEMORY_LIMIT=128m
NGINX_CPU_LIMIT=0.5
NGINX_HEALTHCHECK_INTERVAL=10s
NGINX_HEALTHCHECK_TIMEOUT=5s
NGINX_HEALTHCHECK_RETRIES=10
NGINX_HEALTHCHECK_START_PERIOD=10s
